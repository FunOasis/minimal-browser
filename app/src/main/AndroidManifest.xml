<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- WRITE_EXTERNAL_STORAGE (previously declared here with
         android:maxSdkVersion="28") has been removed. Every path this app
         writes downloads to is app-specific external storage
         (Context.getExternalFilesDir(DIRECTORY_DOWNLOADS), used by both
         DownloadHandler and BlobDownloadHelper) or MediaStore.Downloads on
         API 29+ -- neither has required this permission since well before
         this app's minSdk of 26: writes to an app's own external-storage
         directory have not needed WRITE_EXTERNAL_STORAGE since API 19
         (KitKat). The declaration was dead weight carried for years, not
         a permission anything in this app's actual storage paths needed.
         If you ever add a feature that writes into the SHARED public
         Downloads folder via the legacy File API (as opposed to
         MediaStore or app-specific storage), re-add it scoped to
         maxSdkVersion="28" at that point. -->

    <application
        android:name=".MinimalBrowserApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MinimalBrowser"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- configChanges now covers split-screen (screenLayout,
             smallestScreenSize), fold/unfold and display-density changes
             (density) and dark-mode toggles (uiMode). Without these the
             activity was recreated (every WebView destroyed and every
             tab reloaded from its URL) for config changes that a
             browser can absorb without a rebuild. Locale is deliberately
             NOT handled so language switches still recreate cleanly. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DownloadsActivity"
            android:exported="false"
            android:label="@string/downloads_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="@string/history_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".BookmarksActivity"
            android:exported="false"
            android:label="@string/bookmarks_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:label="@string/vault_title"
            android:parentActivityName=".MainActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
