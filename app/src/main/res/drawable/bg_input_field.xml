<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: accent border glow -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1EFFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="@color/urlbar_border_focused" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Default: subtle white hairline -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#16FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/urlbar_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>
