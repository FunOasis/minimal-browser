<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: accent border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1EFFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="@color/urlbar_border_focused" />
            <corners android:radius="@dimen/urlbar_corner" />
        </shape>
    </item>

    <!-- Default: subtle 12% white hairline border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#16FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/urlbar_border" />
            <corners android:radius="@dimen/urlbar_corner" />
        </shape>
    </item>

</selector>
