<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/window_bg"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- Top bar: [back] [forward] [ URL pill: favicon | text | menu ] -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/topbar_padding_h"
        android:paddingEnd="@dimen/topbar_padding_h"
        android:paddingTop="@dimen/topbar_padding_v"
        android:paddingBottom="@dimen/topbar_padding_v">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.MinimalBrowser.IconButton"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back" />

        <ImageButton
            android:id="@+id/btnForward"
            style="@style/Widget.MinimalBrowser.IconButton"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="@string/cd_forward" />

        <!-- URL pill.
             `addStatesFromChildren` makes this wrapper inherit the
             EditText's focused state, so bg_urlbar's selector can
             swap the border colour without any Kotlin glue. -->
        <LinearLayout
            android:id="@+id/urlPill"
            android:layout_width="0dp"
            android:layout_height="@dimen/urlbar_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/urlbar_margin_start"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_urlbar"
            android:addStatesFromChildren="true"
            android:paddingStart="@dimen/urlbar_padding_start"
            android:paddingEnd="@dimen/urlbar_padding_end">

            <ImageView
                android:id="@+id/favicon"
                android:layout_width="@dimen/favicon_size"
                android:layout_height="@dimen/favicon_size"
                android:layout_marginEnd="@dimen/favicon_margin_end"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:src="@android:drawable/ic_menu_info_details"
                tools:visibility="visible" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="@dimen/text_urlbar"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/btnMenu"
                style="@style/Widget.MinimalBrowser.IconButton"
                android:src="@drawable/ic_menu"
                android:contentDescription="@string/cd_menu" />
        </LinearLayout>
    </LinearLayout>

    <!-- M3 LinearProgressIndicator: thinner, rounded, animates smoothly.
         Same @+id/progressBar so MainActivity.kt needs no changes —
         LinearProgressIndicator extends ProgressBar. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:trackThickness="@dimen/progress_thickness"
        app:trackCornerRadius="1dp"
        app:indicatorColor="@color/accent"
        app:trackColor="@color/progress_track"
        tools:visibility="visible" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/window_bg" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
