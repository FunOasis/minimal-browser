<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/window_bg"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!--
        Topbar rhythm rule: every horizontal gap in this row equals
        @dimen/topbar_gap, and the padding at both screen edges equals
        the same value. Concretely:
          [8dp][forward][8dp][badge][8dp][urlpill][8dp][menu][8dp]
        Each item carries only a leading margin (marginStart), never a
        trailing margin, so the distance between any two neighbours is
        exactly one gap.
    -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/topbar_padding_h"
        android:paddingEnd="@dimen/topbar_padding_h"
        android:paddingTop="@dimen/topbar_padding_v"
        android:paddingBottom="@dimen/topbar_padding_v">

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_icon_glass"
            android:contentDescription="@string/cd_forward"
            android:padding="@dimen/icon_button_padding"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_forward"
            android:tint="@color/icon_primary" />

        <TextView
            android:id="@+id/tabBadge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/topbar_gap"
            android:background="@drawable/bg_tab_badge"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cd_tabs"
            tools:text="3/5" />

        <LinearLayout
            android:id="@+id/urlPill"
            android:layout_width="0dp"
            android:layout_height="@dimen/urlbar_height"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/topbar_gap"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_urlbar"
            android:addStatesFromChildren="true"
            android:paddingStart="@dimen/urlbar_padding_start"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/favicon"
                android:layout_width="@dimen/favicon_size"
                android:layout_height="@dimen/favicon_size"
                android:layout_marginEnd="@dimen/favicon_margin_end"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:src="@android:drawable/ic_menu_info_details"
                tools:visibility="visible" />

            <EditText
                android:id="@+id/addressBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="@dimen/text_urlbar"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/jsBadge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_js_badge"
                android:clickable="true"
                android:contentDescription="@string/cd_toggle_js"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:minWidth="26dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="JS"
                android:textColor="@color/js_badge_text"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:layout_marginStart="@dimen/topbar_gap"
            android:background="@drawable/bg_icon_glass_rect"
            android:contentDescription="@string/cd_menu"
            android:padding="@dimen/icon_button_padding"
            android:scaleType="centerInside"
            android:src="@drawable/ic_menu"
            android:tint="@color/icon_primary" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:trackThickness="@dimen/progress_thickness"
        app:trackCornerRadius="1dp"
        app:indicatorColor="@color/accent"
        app:trackColor="@color/progress_track"
        tools:visibility="visible" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/webViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/footerText"
        android:layout_width="match_parent"
        android:layout_height="@dimen/footer_height"
        android:gravity="center"
        android:letterSpacing="0.32"
        android:text="@string/footer_brand"
        android:textColor="@color/footer_text"
        android:textSize="10sp"
        android:importantForAccessibility="no" />
</LinearLayout>
